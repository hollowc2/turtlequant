# Deribit IV feed (strongly recommended for rate limits)
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# Trading parameters (optional — compose/CLI defaults apply)
ENTRY_THRESHOLD=
KELLY_FRACTION=
STARTING_NAV=

# Polymarket CLOB v2 (required for --live; optional for --shadow books)
POLYMARKET_PRIVATE_KEY=
# API trio optional — auto-derived from private key if omitted
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYGON_RPC_URL=https://polygon-rpc.com

# Proxy wallet (optional — use when funds sit in Polymarket proxy, not signing EOA)
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER=

# Legacy aliases (shared with crypto_up_or_down .env)
# PRIVATE_KEY=
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=
# FUNDER_ADDRESS=
# SIGNATURE_TYPE=0
