# Deribit IV feed (optional; public IV data works without credentials)
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# Trading parameters (optional — compose/CLI defaults apply)
ENTRY_THRESHOLD=
KELLY_FRACTION=
STARTING_NAV=

# Polymarket CLOB v2 (--live only; shadow/paper use public endpoints and never read these)
POLYMARKET_PRIVATE_KEY=
# API trio optional — auto-derived from private key if omitted
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Live needs a dedicated signing EOA (0). Proxy wallets (1) are not supported yet:
# migrate_pusd_v2.py refuses them and docker-compose.live.yml pins 0.
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER=

# Legacy aliases (shared with crypto_up_or_down .env)
# PRIVATE_KEY=
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=
# FUNDER_ADDRESS=
# SIGNATURE_TYPE=0
