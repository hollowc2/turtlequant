# TurtleQuant public performance page — hourly, at :07 past (crypto trades 24/7).
# Writes https://billybitcoin.cloud/turtlequant/ from the shadow-mode state.
# The log stays outside the web root so it is never served.
# Install (as the user that owns /var/www/billybitcoin.cloud/html):
#   crontab -l 2>/dev/null | grep -v generate_performance_page | cat - scripts/performance_page.cron | crontab -
7 * * * * cd /opt/polymarket/app/turtlequant && "$HOME/.local/bin/uv" run python scripts/generate_performance_page.py --state-dir /opt/turtlequant/state --mode shadow >> /opt/turtlequant/state/performance-page.log 2>&1
